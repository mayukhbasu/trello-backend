{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "lerna bootstrap",
    "build": "lerna run build",
    "start:all": "lerna run start:dev --parallel",
    "start:user-service": "lerna run start:dev --scope user-service",
    "start:board-service": "lerna run start:dev --scope board-service",
    "start:card-service": "lerna run start:dev --scope card-service",
    "clean": "lerna run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "lerna": "^7.0.0",
    "rimraf": "^5.0.0"
  },
  "dependencies": {
    "@nestjs/config": "^3.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "typeorm": "^0.3.20",
    "shared-lib": "*"
  }
}
